#!/usr/bin/env bash
#
# This script will recover dentry recovery from journal and reset it
# using a procedure described in:
#
# https://docs.ceph.com/en/quincy/cephfs/disaster-recovery-experts/#dentry-recovery-from-journal
#

set -eo pipefail

#
# Globals
#
CEPHFS=
RANKS=
LOGDIR=recover_journal_logs
BACKUP_JOURNAL="${BACKUP_JOURNAL:-}"
JOURNAL_RESET_COMPAT_FLAGS=
: ${DRY_RUN:=}
: ${CONCURRENCY:=}
: ${PROCEED_ON_RECOVER_FAILURE:=}

declare -A RECOVERY_STEPS=(
  [backup]="BACKING JOURNAL UP TO ${BACKUP_JOURNAL}"
  [recover_journal_dentries]="RECOVERING JOURNAL DENTRIES"
  [reset_journal]="RESETTING JOURNAL"
  [recover_journal]="RECOVERING JOURNAL DENTRIES AND RESETTING JOURNAL"
  [end]="RECOVERY COMPLETE"
)
CURRENT_RECOVERY_STEP=""


#
# Functions
#

usage() {
    echo "$0 [options] <cephfs> [ranks ...]"
    echo
    echo "Options:"
    echo
    echo "  -b | --backup-journal <path>  export journals to <path>.<rank>"
    echo "  -c | --concurrent <N>         process at most <N> ranks concurrently"
    echo "                                (<N> = 0 means all of them); the journal"
    echo "                                backup, if requested, is done concurrently"
    echo "                                as well; implies"
    echo "                                --proceed-on-recover-failure"
    echo "  -d | --log-dir <dir>          directory to store logs"
    echo "                                (default: ${LOGDIR})"
    echo "  -f | --proceed-on-recover-failure"
    echo "                                continue to journal reset even if"
    echo "                                recover_dentries fails"
    echo "  -h | --help                   show this help message and exit"
    echo "  -n | --dry-run                log recovery commands without executing them"
    echo
}

set_recovery_step() {
    local step="$1"

    if [ -n "${CURRENT_RECOVERY_STEP}" ]; then
        echo "${RECOVERY_STEPS[${CURRENT_RECOVERY_STEP}]} DONE" >&2
    fi

    CURRENT_RECOVERY_STEP="${step}"

    echo "${RECOVERY_STEPS[${step}]}" >&2
}

on_exit() {
    local rc=$?

    if [ $rc -ne 0 ] && [ -n "${CURRENT_RECOVERY_STEP}" ]; then
        echo "${RECOVERY_STEPS[${CURRENT_RECOVERY_STEP}]} FAILED" >&2
    fi

    exit $rc
}

set_compat_flags() {
    if cephfs-journal-tool --help |
            grep -q 'reset .*--yes-i-really-really-mean-it'; then
        JOURNAL_RESET_COMPAT_FLAGS="--yes-i-really-really-mean-it"
    fi
}

prepare_log_dir() {
    test -n "${LOGDIR}"

    mkdir -p "${LOGDIR}"
    rm -f "${LOGDIR}"/*.log

    echo "logs will be stored in ${LOGDIR}" >&2
}

set_ranks() {
    local nranks rank

    nranks=$(ceph fs get ${CEPHFS} --format json |
		 jq '.mdsmap.max_mds')

    if [ -n "${RANKS}" ]; then
	for rank in ${RANKS}; do
	    if [ "${rank}" -lt 0 ] || [ "${rank}" -ge "${nranks}" ]; then
		echo "invalid rank: ${rank}" 2>&2
		return 1
	    fi
	done

	return 0
    fi

    RANKS=$(seq 0 $((nranks - 1)))
}

recover_dentries() {
    local rank="$1"

    if run recover_dentries.${rank} \
        cephfs-journal-tool --rank=${CEPHFS}:${rank} event recover_dentries summary; then
        return 0
    fi

    if [ "${PROCEED_ON_RECOVER_FAILURE}" = "YES" ]; then
        echo "recover_dentries failed for rank ${rank}, proceeding with journal reset" >&2
        return 0
    fi

    echo "recover_dentries failed for rank ${rank}" >&2
    echo "re-run with --proceed-on-recover-failure to continue anyway" >&2
    return 1
}

backup_journal() {
    local rank="$1"

    echo "Backing journal up for rank ${rank}" >&2

    run journal_export.${rank} \
        cephfs-journal-tool --rank=${CEPHFS}:${rank} journal export \
            "${BACKUP_JOURNAL}".${rank}
}

recover_journal() {
    local rank="$1"

    # try to recover whatever is possible from journal and reset it
    recover_dentries "${rank}"

    run journal_reset.${rank} \
        cephfs-journal-tool --rank=${CEPHFS}:${rank} journal reset --force \
            ${JOURNAL_RESET_COMPAT_FLAGS}
}

# Wait for all the given background jobs, failing if any of them failed.
# Unlike a bare "wait", this does not stop at the first failure, so every
# job is given a chance to complete before we bail out.
#
# Note that "wait" looks the pid up in the shell job table, so it is fine
# to call it long after the job has completed. The only (very unlikely)
# exception would be the pid counter wrapping around meanwhile and the
# shell starting a new child with the same pid: the status of the old job
# is dropped then and its failure would go unnoticed.
wait_jobs() {
    local pid rc=0

    for pid in "$@"; do
        wait "${pid}" || rc=1
    done

    return ${rc}
}

# Wait until less than ${CONCURRENCY} jobs are running.
throttle_jobs() {
    test "${CONCURRENCY}" -gt 0 || return 0

    while true; do
        jobs -r > "${LOGDIR}"/jobs
        test $(wc -l < "${LOGDIR}"/jobs) -lt "${CONCURRENCY}" && break
        sleep 1
    done
}

# Run the given function for every rank, sequentially, or, if
# --concurrent is specified, concurrently, running at most ${CONCURRENCY}
# jobs at a time (all the ranks if it is 0).
run_for_ranks() {
    local fn="$1"
    local rank pids=

    if [ -z "${CONCURRENCY}" ]; then
        for rank in ${RANKS}; do
            "${fn}" "${rank}"
        done

        return 0
    fi

    for rank in ${RANKS}; do
        throttle_jobs
        "${fn}" "${rank}" &
        pids="${pids} $!"
    done

    wait_jobs ${pids}
}

run() {
    local name="$1"; shift
    local dry=

    test "${DRY_RUN}" = "YES" && dry="dry-"

    echo "${dry}running: $@" >&2
    echo $(date "+%F %T") "$@" >> "${LOGDIR}/${name}.log"

    test "${DRY_RUN}" = "YES" && return

    "$@" 2>&1 | tee -a "${LOGDIR}/${name}.log" >&2
}


#
# Main
#

OPTIONS=$(getopt -o b:c:d:fhn --long backup-journal:,concurrent:,log-dir:,proceed-on-recover-failure,help,dry-run -- "$@")

eval set -- "$OPTIONS"
while true; do
    case "$1" in
        -b|--backup-journal)
            BACKUP_JOURNAL="$2"
            shift 2
            ;;
        -c|--concurrent)
            CONCURRENCY="$2"
            PROCEED_ON_RECOVER_FAILURE=YES
            shift 2
            ;;
        -d|--log-dir)
            if [ -d "$2" ]; then
                echo "Log directory $2 already exists" >&2
                exit 1
            fi
            LOGDIR="$2"
            shift 2
            ;;
        -n|--dry-run)
            DRY_RUN=YES
            shift
            ;;
        -f|--proceed-on-recover-failure)
            PROCEED_ON_RECOVER_FAILURE=YES
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        *)
            echo "Invalid option: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
done

RECOVERY_STEPS[backup]="BACKING JOURNAL UP TO ${BACKUP_JOURNAL}"

if [ -n "$1" ]; then
    CEPHFS=$1
    shift
fi

if [ -z "${CEPHFS}" ]; then
    echo "cephfs name is required" >&2
    usage >&2
    exit 1
fi

if [ -n "${CONCURRENCY}" ] && ! [ "${CONCURRENCY}" -ge 0 ] 2>/dev/null; then
    echo "invalid concurrency: ${CONCURRENCY}" >&2
    usage >&2
    exit 1
fi

RANKS="$@"
set_ranks

set_compat_flags
prepare_log_dir

trap on_exit EXIT

if [ -n "${BACKUP_JOURNAL}" ]; then
    set_recovery_step backup
    run_for_ranks backup_journal
fi

if [ -n "${CONCURRENCY}" ]; then
    set_recovery_step recover_journal
    run_for_ranks recover_journal
else
    set_recovery_step recover_journal_dentries
    for rank in ${RANKS}; do

        # try to recover whatever is possible from journal
        recover_dentries "${rank}"
    done

    set_recovery_step reset_journal
    for rank in ${RANKS}; do
        run journal_reset.${rank} \
            cephfs-journal-tool --rank=${CEPHFS}:${rank} journal reset --force \
                ${JOURNAL_RESET_COMPAT_FLAGS}
    done
fi

set_recovery_step end
